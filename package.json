    "react-native": "0.88.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
