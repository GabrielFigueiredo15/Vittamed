{
  "expo": {
    "name": "Vittamed",
    "slug": "vittamed",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.vittamed.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#5B3FD9",
          "defaultChannel": "doses"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Vittamed usa suas fotos só para a foto do perfil e da embalagem dos remédios.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00f926e3-8fa7-4b8b-aaca-7803e3f19269"
      }
    },
    "owner": "gabrielcatter"
  }
}
